      "Bash(python tools/*)",
      "Bash(python -m unittest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "PowerShell(*gh-portable*gh.exe* run list*)",
