      "Bash(python -X utf8 tools/*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git pull --rebase*)",
